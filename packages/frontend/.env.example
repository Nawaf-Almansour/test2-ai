# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Environment
NODE_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true

# School Information
NEXT_PUBLIC_SCHOOL_NAME="Al Riyadh International School"
NEXT_PUBLIC_SCHOOL_PHONE="+966 50 123 4567"
NEXT_PUBLIC_SCHOOL_EMAIL="admissions@school.edu.sa"

# Registration Settings
NEXT_PUBLIC_MAX_FILE_SIZE=5242880  # 5MB in bytes
NEXT_PUBLIC_ALLOWED_FILE_TYPES="image/jpeg,image/png,application/pdf"

# Rate Limiting
NEXT_PUBLIC_RATE_LIMIT_REQUESTS=5
NEXT_PUBLIC_RATE_LIMIT_WINDOW=900000  # 15 minutes in milliseconds

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Google Maps (optional for address)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=